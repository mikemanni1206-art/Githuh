# Schwab Developer API credentials
# Register at https://developer.schwab.com to get these
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here

# Redirect URI registered in your Schwab app (must match exactly)
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182

# Path to store the OAuth token (auto-created on first login)
SCHWAB_TOKEN_PATH=token.json

# ─────────────────────────────────────────────
# Polymarket credentials
# ─────────────────────────────────────────────
# Private key of the Polygon wallet linked to your Polymarket account
# (hex string, with or without 0x prefix)
POLYMARKET_PRIVATE_KEY=your_polygon_wallet_private_key_here

# L2 API credentials — leave blank to auto-derive from your private key on first run.
# After first run, copy the printed values here to skip re-derivation.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Path to cache derived API credentials (auto-created on first run)
POLYMARKET_CREDS_PATH=polymarket_creds.json

# CLOB API host (default is mainnet; change for testnet if needed)
POLYMARKET_HOST=https://clob.polymarket.com

# Chain ID: 137 = Polygon mainnet, 80002 = Polygon Amoy testnet
POLYMARKET_CHAIN_ID=137
