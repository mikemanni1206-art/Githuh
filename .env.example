# Schwab Developer API credentials
# Register at https://developer.schwab.com to get these
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here

# Redirect URI registered in your Schwab app (must match exactly)
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182

# Path to store the OAuth token (auto-created on first login)
SCHWAB_TOKEN_PATH=token.json

# ── Polymarket CLOB API credentials ──────────────────────────────────────────
# Your Ethereum private key for the wallet connected to Polymarket.
# KEEP THIS SECRET — never commit it to source control.
POLYMARKET_PRIVATE_KEY=0xyour_private_key_here

# Polygon chain ID: 137 = mainnet, 80002 = Amoy testnet
POLYMARKET_CHAIN_ID=137

# API credentials (auto-generated on first run from your private key).
# After the first run, copy the printed values here to skip re-generation.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
